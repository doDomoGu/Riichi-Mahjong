[Unit]
Description=立直麻将工具集统一网关
After=network.target mahjong-wind.service

[Service]
Type=simple
WorkingDirectory=/opt/riichi-mahjong
Environment=NODE_ENV=production
Environment=PORT=8081
Environment=WIND_TARGET=http://127.0.0.1:3000
ExecStart=/usr/bin/env node server/index.js
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
